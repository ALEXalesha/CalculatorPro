<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable, Segoe UI, -apple-system, SF Pro Display</FontFamily>

    <!-- ===== Base text style ===== -->
    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
    </Style>

    <!-- ===== Window background — layered cosmic gradient ===== -->
    <LinearGradientBrush x:Key="WindowBaseBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0E0C1A" Offset="0" />
        <GradientStop Color="#FF1A1330" Offset="0.5" />
        <GradientStop Color="#FF0C1024" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WindowGlowVioletTL"
                         GradientOrigin="0.12,-0.10"
                         Center="0.12,-0.10"
                         RadiusX="0.65" RadiusY="0.85"
                         MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#8C7890FF" Offset="0" />
        <GradientStop Color="#007890FF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WindowGlowPinkTR"
                         GradientOrigin="0.95,0.08"
                         Center="0.95,0.08"
                         RadiusX="0.55" RadiusY="0.75"
                         MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#66FF64B4" Offset="0" />
        <GradientStop Color="#00FF64B4" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WindowGlowCyanBR"
                         GradientOrigin="0.85,1.10"
                         Center="0.85,1.10"
                         RadiusX="0.55" RadiusY="0.85"
                         MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#663CC8FF" Offset="0" />
        <GradientStop Color="#003CC8FF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WindowGlowGreenBL"
                         GradientOrigin="0.05,1.05"
                         Center="0.05,1.05"
                         RadiusX="0.50" RadiusY="0.75"
                         MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#4D64FFB4" Offset="0" />
        <GradientStop Color="#0064FFB4" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
