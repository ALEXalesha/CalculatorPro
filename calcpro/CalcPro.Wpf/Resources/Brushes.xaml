<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Solid accent colors ===== -->
    <Color x:Key="AccentColor">#FF5B8DEF</Color>
    <Color x:Key="Accent2Color">#FF9D5BEF</Color>
    <Color x:Key="AccentDangerColor">#FFFF5B5B</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />

    <!-- ===== Text ===== -->
    <SolidColorBrush x:Key="TextBrush" Color="#FFF4F4F8" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#9EF4F4F8" />

    <!-- ===== Glass ===== -->
    <SolidColorBrush x:Key="GlassBg" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassBgStrong" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="GlassBgSoft" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="GlassBorder" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#52FFFFFF" />

    <!-- ===== Accent gradient (135deg = top-left → bottom-right) ===== -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
    </LinearGradientBrush>

    <!-- ===== Operator tint (subtle blue) ===== -->
    <SolidColorBrush x:Key="OperatorTint" Color="#2E5B8DEF" />

    <!-- ===== Danger tint for AC / C / Backspace ===== -->
    <SolidColorBrush x:Key="DangerTint" Color="#2EFF5B5B" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFFB3B3" />

    <!-- ===== Display panel inner glass ===== -->
    <SolidColorBrush x:Key="DisplayBg" Color="#0AFFFFFF" />

    <!-- ===== Top specular highlight (used in panel ::before) ===== -->
    <LinearGradientBrush x:Key="PanelSpecular" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#05FFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </LinearGradientBrush>

    <!-- ===== Bubble fills — radial whites blended with hue tints ===== -->
    <RadialGradientBrush x:Key="BubbleVioletFill" Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#8CFFFFFF" Offset="0" />
        <GradientStop Color="#40C8DCFF" Offset="0.35" />
        <GradientStop Color="#1A7890FF" Offset="0.7" />
        <GradientStop Color="#007890FF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BubblePinkFill" Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#8CFFFFFF" Offset="0" />
        <GradientStop Color="#47FFAAD2" Offset="0.4" />
        <GradientStop Color="#1FFF64B4" Offset="0.75" />
        <GradientStop Color="#00FF64B4" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BubbleCyanFill" Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#8CFFFFFF" Offset="0" />
        <GradientStop Color="#473CC8FF" Offset="0.4" />
        <GradientStop Color="#1F3CC8FF" Offset="0.75" />
        <GradientStop Color="#003CC8FF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="BubbleGreenFill" Center="0.3,0.3" GradientOrigin="0.3,0.3" RadiusX="0.7" RadiusY="0.7">
        <GradientStop Color="#8CFFFFFF" Offset="0" />
        <GradientStop Color="#4764FFB4" Offset="0.4" />
        <GradientStop Color="#1F64FFB4" Offset="0.75" />
        <GradientStop Color="#0064FFB4" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
