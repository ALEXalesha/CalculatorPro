<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CalcWinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CalcWinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Стиль для всех кнопок калькулятора: круглые, "стекло" -->
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="40" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background">
                <Setter.Value>
                    <AcrylicBrush
                        TintColor="#3C3C43"
                        TintOpacity="0.55"
                        TintLuminosityOpacity="0.45"
                        FallbackColor="#3C3C43" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Оранжевые операторы (÷ × − + =) -->
        <Style x:Key="OpButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="Background" Value="#FF9F0A" />
        </Style>

        <!-- Верхний ряд (⌫ AC %) — светлее -->
        <Style x:Key="TopButton" TargetType="Button" BasedOn="{StaticResource CalcButton}">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background">
                <Setter.Value>
                    <AcrylicBrush
                        TintColor="#A5A5A5"
                        TintOpacity="0.55"
                        TintLuminosityOpacity="0.7"
                        FallbackColor="#A5A5A5" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />     <!-- дисплей -->
            <RowDefinition Height="Auto" />  <!-- кнопки -->
        </Grid.RowDefinitions>

        <!-- Дисплей -->
        <Grid Grid.Row="0" VerticalAlignment="Bottom" Margin="8,0,8,8">
            <StackPanel HorizontalAlignment="Stretch">
                <TextBlock x:Name="ExpressionText"
                           Text=""
                           Foreground="#8E8E93"
                           FontSize="22"
                           TextAlignment="Right"
                           TextWrapping="NoWrap"
                           Margin="0,0,8,0" />
                <TextBlock x:Name="ResultText"
                           Text="0"
                           Foreground="White"
                           FontSize="72"
                           FontWeight="Light"
                           TextAlignment="Right"
                           TextWrapping="NoWrap"
                           Margin="0,4,8,0" />
            </StackPanel>
        </Grid>

        <!-- Сетка кнопок 5x4 -->
        <Grid Grid.Row="1" Height="440">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Ряд 1: ⌫ AC % ÷ -->
            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource TopButton}" Tag="bksp"  Content="⌫" Click="OnButtonClick" />
            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource TopButton}" Tag="clear" Content="AC" x:Name="ClearBtn" Click="OnButtonClick" />
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource TopButton}" Tag="pct"   Content="%" Click="OnButtonClick" />
            <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource OpButton}"  Tag="op:/"  Content="÷" x:Name="OpDiv" Click="OnButtonClick" />

            <!-- Ряд 2: 7 8 9 × -->
            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CalcButton}" Tag="d:7" Content="7" Click="OnButtonClick" />
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CalcButton}" Tag="d:8" Content="8" Click="OnButtonClick" />
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CalcButton}" Tag="d:9" Content="9" Click="OnButtonClick" />
            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource OpButton}"   Tag="op:*" Content="×" x:Name="OpMul" Click="OnButtonClick" />

            <!-- Ряд 3: 4 5 6 − -->
            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource CalcButton}" Tag="d:4" Content="4" Click="OnButtonClick" />
            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CalcButton}" Tag="d:5" Content="5" Click="OnButtonClick" />
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CalcButton}" Tag="d:6" Content="6" Click="OnButtonClick" />
            <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource OpButton}"   Tag="op:-" Content="−" x:Name="OpSub" Click="OnButtonClick" />

            <!-- Ряд 4: 1 2 3 + -->
            <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource CalcButton}" Tag="d:1" Content="1" Click="OnButtonClick" />
            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource CalcButton}" Tag="d:2" Content="2" Click="OnButtonClick" />
            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CalcButton}" Tag="d:3" Content="3" Click="OnButtonClick" />
            <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource OpButton}"   Tag="op:+" Content="+" x:Name="OpAdd" Click="OnButtonClick" />

            <!-- Ряд 5: ± 0 , = -->
            <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource CalcButton}" Tag="neg"   Content="±" Click="OnButtonClick" />
            <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource CalcButton}" Tag="d:0"   Content="0" Click="OnButtonClick" />
            <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CalcButton}" Tag="d:,"   Content="," Click="OnButtonClick" />
            <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource OpButton}"   Tag="op:="  Content="=" Click="OnButtonClick" />
        </Grid>
    </Grid>
</Page>
