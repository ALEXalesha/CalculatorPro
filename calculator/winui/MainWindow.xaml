<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CalcPro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Calc Pro">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />   <!-- Titlebar -->
            <RowDefinition Height="Auto" /> <!-- Mode tabs / angle pill -->
            <RowDefinition Height="*" />    <!-- Display -->
            <RowDefinition Height="Auto" /> <!-- Memory row -->
            <RowDefinition Height="Auto" /> <!-- Keypad -->
        </Grid.RowDefinitions>

        <!-- Custom titlebar with drag region + window controls.
             PointerPressed sends WM_NCLBUTTONDOWN so the OS drags the window
             (SetTitleBar can't anchor a drag region without an OS titlebar). -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent"
              PointerPressed="AppTitleBar_PointerPressed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Calc Pro"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource TextDimBrush}" FontSize="12" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,4,0">
                <Button x:Name="BtnHistory"  Style="{StaticResource CaptionButton}" Click="BtnHistory_Click">
                    <FontIcon Glyph="&#xE81C;" FontSize="12" />
                </Button>
                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButton}" Click="BtnMinimize_Click">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button x:Name="BtnClose"    Style="{StaticResource CaptionButton}" Click="BtnClose_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFE81123" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Mode tabs -->
        <Grid Grid.Row="1" Margin="14,4,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="TabStandard"   Content="Standard"   Click="TabStandard_Click"   Style="{StaticResource SciButton}" Margin="0,0,4,0" />
            <Button Grid.Column="1" x:Name="TabScientific" Content="Scientific" Click="TabScientific_Click" Style="{StaticResource SciButton}" Margin="2,0,2,0" />
            <Button Grid.Column="2" x:Name="TabFraction"   Content="Fraction"   Click="TabFraction_Click"   Style="{StaticResource SciButton}" Margin="4,0,8,0" />
            <Button Grid.Column="3" x:Name="AnglePill"     Content="DEG"        Click="AnglePill_Click"
                    Style="{StaticResource SciButton}"
                    MinWidth="56" Visibility="Collapsed" />
        </Grid>

        <!-- Display area -->
        <Grid Grid.Row="2" Margin="14,4,14,8" RowSpacing="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" x:Name="HistoryLine"
                       Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Right"
                       FontSize="14" />
            <TextBlock Grid.Row="1" x:Name="MainResult"
                       Text="0"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       FontSize="56" FontWeight="Light" TextWrapping="NoWrap"
                       FontFamily="Segoe UI Variable, Segoe UI" />
            <TextBlock Grid.Row="2" x:Name="FractionLine"
                       Foreground="{StaticResource AccentBlue}"
                       HorizontalAlignment="Right"
                       FontSize="14" Visibility="Collapsed" />
        </Grid>

        <!-- Memory row (only in scientific) -->
        <Grid Grid.Row="3" x:Name="MemRow" Margin="14,0,14,8" Visibility="Collapsed" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="MC" Click="MemClear_Click"  Style="{StaticResource SciButton}" />
            <Button Grid.Column="1" Content="MR" Click="MemRecall_Click" Style="{StaticResource SciButton}" />
            <Button Grid.Column="2" Content="M+" Click="MemAdd_Click"    Style="{StaticResource SciButton}" />
            <Button Grid.Column="3" Content="M−" Click="MemSub_Click"    Style="{StaticResource SciButton}" />
            <Button Grid.Column="4" Content="MS" Click="MemStore_Click"  Style="{StaticResource SciButton}" />
        </Grid>

        <!-- Keypad — populated from code-behind based on mode -->
        <Grid Grid.Row="4" x:Name="KeyPad"
              Margin="10,0,10,10"
              RowSpacing="6" ColumnSpacing="6" />
    </Grid>
</Window>
