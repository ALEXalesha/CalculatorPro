<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="CalcPro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Liquid-glass token palette ported 1:1 from calc-pro.html :root vars -->
            <SolidColorBrush x:Key="TextBrush"        Color="#F4F4F8" />
            <SolidColorBrush x:Key="TextDimBrush"     Color="#9EF4F4F8" />
            <SolidColorBrush x:Key="GlassBg"          Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GlassBgStrong"    Color="#24FFFFFF" />
            <SolidColorBrush x:Key="GlassBgSoft"      Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="GlassBorder"      Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="GlassBorderStrong" Color="#52FFFFFF" />
            <SolidColorBrush x:Key="AccentBlue"       Color="#5B8DEF" />
            <SolidColorBrush x:Key="AccentPurple"     Color="#9D5BEF" />

            <!-- Apple-calculator key palette -->
            <SolidColorBrush x:Key="DigitBg"     Color="#8C3C3C4B" />
            <SolidColorBrush x:Key="DigitBgHover" Color="#A5505064" />
            <SolidColorBrush x:Key="UtilBg"      Color="#8CA5A5AF" />
            <SolidColorBrush x:Key="UtilBgHover" Color="#B3BEBEC8" />
            <SolidColorBrush x:Key="DelBg"       Color="#73FF5B5B" />
            <SolidColorBrush x:Key="DelBgHover"  Color="#99FF7878" />
            <SolidColorBrush x:Key="OpBg"        Color="#FFFF9F0A" />
            <SolidColorBrush x:Key="OpBgHover"   Color="#FFFFB340" />
            <SolidColorBrush x:Key="SciBg"       Color="#66202030" />
            <SolidColorBrush x:Key="SciBgHover"  Color="#99303040" />

            <!-- Common rounded button style -->
            <Style x:Key="GlassButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DigitBg}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <Style x:Key="DigitButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
                <Setter Property="Background" Value="{StaticResource DigitBg}" />
            </Style>
            <Style x:Key="UtilButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
                <Setter Property="Background" Value="{StaticResource UtilBg}" />
                <Setter Property="Foreground" Value="#1A1A1F" />
            </Style>
            <Style x:Key="DelButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
                <Setter Property="Background" Value="{StaticResource DelBg}" />
            </Style>
            <Style x:Key="OpButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
                <Setter Property="Background" Value="{StaticResource OpBg}" />
                <Setter Property="FontSize" Value="26" />
            </Style>
            <Style x:Key="EqButton" TargetType="Button" BasedOn="{StaticResource OpButton}" />
            <Style x:Key="SciButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
                <Setter Property="Background" Value="{StaticResource SciBg}" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <!-- Caption (window control) button -->
            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
