<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Кадры для README. Не входит в CalcPro.sln и в сборку: запускается руками,
    команда в начале Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CalcPro.Wpf\CalcPro.Wpf.csproj" />
  </ItemGroup>

</Project>
