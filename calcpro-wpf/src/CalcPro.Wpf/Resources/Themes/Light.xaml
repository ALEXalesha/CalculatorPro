<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      «Светлая» - тёмный текст на светлом; стекло становится тёмным с малой прозрачностью.

      Темы те же пять, что в Paint Pro, со значениями из его словарей
      (Paint/src/PaintPro.Wpf/Resources/Themes). Тема - это НАБОР ТЕХ ЖЕ КЛЮЧЕЙ: смена
      темы сводится к подмене этого словаря (ThemeService), поэтому ключи обязаны
      совпадать во всех пяти до одного, а обращаться к ним - через DynamicResource.
      Проверяет tests/CalcPro.Tests/ThemeFileTests.cs.
    -->

    <SolidColorBrush x:Key="AppBase" Color="#FFE8ECF3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3A6FD8" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#FF7A52D0" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3A6FD8" Offset="0" />
        <GradientStop Color="#FF7A52D0" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="AccentGlow" Color="#3A6FD8" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />

    <SolidColorBrush x:Key="TextBrush" Color="#FF1B2030" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF5A6072" />

    <SolidColorBrush x:Key="GlassBg" Color="#0C161A26" />
    <SolidColorBrush x:Key="GlassBgStrong" Color="#1A161A26" />
    <SolidColorBrush x:Key="GlassBgSoft" Color="#08161A26" />
    <SolidColorBrush x:Key="GlassBorder" Color="#24161A26" />
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#42161A26" />
    <SolidColorBrush x:Key="DisplayBg" Color="#0A161A26" />

    <SolidColorBrush x:Key="OperatorTint" Color="#383A6FD8" />
    <SolidColorBrush x:Key="DangerTint" Color="#2EFF5B5B" />
    <SolidColorBrush x:Key="DangerText" Color="#FFB42323" />

    <LinearGradientBrush x:Key="PanelSpecular" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#05FFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowBaseBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFEFF2F7" Offset="0" />
        <GradientStop Color="#FFE3E8F0" Offset="0.5" />
        <GradientStop Color="#FFDDE3ED" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowGlowVioletTL" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowPinkTR" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowCyanBR" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowGreenBL" Color="Transparent" />

</ResourceDictionary>
