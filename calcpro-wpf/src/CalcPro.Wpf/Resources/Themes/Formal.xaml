<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      «Строгая» - ровный тёмный фон, приглушённый синий, без цветных пятен.

      Темы те же пять, что в Paint Pro, со значениями из его словарей
      (Paint/src/PaintPro.Wpf/Resources/Themes). Тема - это НАБОР ТЕХ ЖЕ КЛЮЧЕЙ: смена
      темы сводится к подмене этого словаря (ThemeService), поэтому ключи обязаны
      совпадать во всех пяти до одного, а обращаться к ним - через DynamicResource.
      Проверяет tests/CalcPro.Tests/ThemeFileTests.cs.
    -->

    <SolidColorBrush x:Key="AppBase" Color="#FF1F242E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4A7AB8" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#FF5C7FA6" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4A7AB8" Offset="0" />
        <GradientStop Color="#FF5C7FA6" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="AccentGlow" Color="#4A7AB8" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFE6E8EC" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF9BA0AA" />

    <SolidColorBrush x:Key="GlassBg" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="GlassBgStrong" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="GlassBgSoft" Color="#09FFFFFF" />
    <SolidColorBrush x:Key="GlassBorder" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="DisplayBg" Color="#08FFFFFF" />

    <SolidColorBrush x:Key="OperatorTint" Color="#384A7AB8" />
    <SolidColorBrush x:Key="DangerTint" Color="#2EFF5B5B" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFFB3B3" />

    <LinearGradientBrush x:Key="PanelSpecular" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#05FFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowBaseBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1B1F27" Offset="0" />
        <GradientStop Color="#FF232833" Offset="0.5" />
        <GradientStop Color="#FF191D25" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowGlowVioletTL" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowPinkTR" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowCyanBR" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowGreenBL" Color="Transparent" />

</ResourceDictionary>
