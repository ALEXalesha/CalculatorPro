<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      «Тёплая» - тёмная, но не синяя: охра и кофе.

      Темы те же пять, что в Paint Pro, со значениями из его словарей
      (Paint/src/PaintPro.Wpf/Resources/Themes). Тема - это НАБОР ТЕХ ЖЕ КЛЮЧЕЙ: смена
      темы сводится к подмене этого словаря (ThemeService), поэтому ключи обязаны
      совпадать во всех пяти до одного, а обращаться к ним - через DynamicResource.
      Проверяет tests/CalcPro.Tests/ThemeFileTests.cs.
    -->

    <SolidColorBrush x:Key="AppBase" Color="#FF1D1610" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFD08A3C" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#FFB4562F" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD08A3C" Offset="0" />
        <GradientStop Color="#FFB4562F" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="AccentGlow" Color="#D08A3C" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFF5EAD9" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FFB0A08C" />

    <SolidColorBrush x:Key="GlassBg" Color="#12FFECD2" />
    <SolidColorBrush x:Key="GlassBgStrong" Color="#21FFECD2" />
    <SolidColorBrush x:Key="GlassBgSoft" Color="#0CFFECD2" />
    <SolidColorBrush x:Key="GlassBorder" Color="#29FFECD2" />
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#47FFECD2" />
    <SolidColorBrush x:Key="DisplayBg" Color="#0AFFECD2" />

    <SolidColorBrush x:Key="OperatorTint" Color="#38D08A3C" />
    <SolidColorBrush x:Key="DangerTint" Color="#2EFF5B5B" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFFB8A0" />

    <LinearGradientBrush x:Key="PanelSpecular" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#05FFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowBaseBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF17110B" Offset="0" />
        <GradientStop Color="#FF241A10" Offset="0.5" />
        <GradientStop Color="#FF140F0A" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="WindowGlowVioletTL" GradientOrigin="0.12,-0.10" Center="0.12,-0.10"
                         RadiusX="0.65" RadiusY="0.85" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#59BE6E28" Offset="0" />
        <GradientStop Color="#00BE6E28" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="WindowGlowPinkTR" GradientOrigin="0.95,0.08" Center="0.95,0.08"
                         RadiusX="0.55" RadiusY="0.75" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#47963C28" Offset="0" />
        <GradientStop Color="#00963C28" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="WindowGlowCyanBR" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowGreenBL" Color="Transparent" />

</ResourceDictionary>
