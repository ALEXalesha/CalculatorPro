<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      «Стеклянная» - цветной градиент и стекло, как было.

      Темы те же пять, что в Paint Pro, со значениями из его словарей
      (Paint/src/PaintPro.Wpf/Resources/Themes). Тема - это НАБОР ТЕХ ЖЕ КЛЮЧЕЙ: смена
      темы сводится к подмене этого словаря (ThemeService), поэтому ключи обязаны
      совпадать во всех пяти до одного, а обращаться к ним - через DynamicResource.
      Проверяет tests/CalcPro.Tests/ThemeFileTests.cs.
    -->

    <SolidColorBrush x:Key="AppBase" Color="#FF12101F" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5B8DEF" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#FF9D5BEF" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5B8DEF" Offset="0" />
        <GradientStop Color="#FF9D5BEF" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="AccentGlow" Color="#5B8DEF" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFF4F4F8" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF9EA0AE" />

    <SolidColorBrush x:Key="GlassBg" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="GlassBgStrong" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="GlassBgSoft" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="GlassBorder" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="DisplayBg" Color="#0AFFFFFF" />

    <SolidColorBrush x:Key="OperatorTint" Color="#385B8DEF" />
    <SolidColorBrush x:Key="DangerTint" Color="#2EFF5B5B" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFFB3B3" />

    <LinearGradientBrush x:Key="PanelSpecular" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#05FFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowBaseBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0E0C1A" Offset="0" />
        <GradientStop Color="#FF1A1330" Offset="0.5" />
        <GradientStop Color="#FF0C1024" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="WindowGlowVioletTL" GradientOrigin="0.12,-0.10" Center="0.12,-0.10"
                         RadiusX="0.65" RadiusY="0.85" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#8C9D5BFF" Offset="0" />
        <GradientStop Color="#009D5BFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="WindowGlowPinkTR" GradientOrigin="0.95,0.08" Center="0.95,0.08"
                         RadiusX="0.55" RadiusY="0.75" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#66FF64B4" Offset="0" />
        <GradientStop Color="#00FF64B4" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="WindowGlowCyanBR" GradientOrigin="0.85,1.10" Center="0.85,1.10"
                         RadiusX="0.55" RadiusY="0.85" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#663CC8FF" Offset="0" />
        <GradientStop Color="#003CC8FF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="WindowGlowGreenBL" GradientOrigin="0.05,1.05" Center="0.05,1.05"
                         RadiusX="0.50" RadiusY="0.75" MappingMode="RelativeToBoundingBox">
        <GradientStop Color="#4D64FFB4" Offset="0" />
        <GradientStop Color="#0064FFB4" Offset="1" />
    </RadialGradientBrush>

</ResourceDictionary>
