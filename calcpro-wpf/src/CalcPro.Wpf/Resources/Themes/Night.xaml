<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      «Ночная» - почти чёрный фон для тёмной комнаты.

      Темы те же пять, что в Paint Pro, со значениями из его словарей
      (Paint/src/PaintPro.Wpf/Resources/Themes). Тема - это НАБОР ТЕХ ЖЕ КЛЮЧЕЙ: смена
      темы сводится к подмене этого словаря (ThemeService), поэтому ключи обязаны
      совпадать во всех пяти до одного, а обращаться к ним - через DynamicResource.
      Проверяет tests/CalcPro.Tests/ThemeFileTests.cs.
    -->

    <SolidColorBrush x:Key="AppBase" Color="#FF08090E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4668A8" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#FF6A5AA0" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4668A8" Offset="0" />
        <GradientStop Color="#FF6A5AA0" Offset="1" />
    </LinearGradientBrush>
    <DropShadowEffect x:Key="AccentGlow" Color="#4668A8" BlurRadius="24" ShadowDepth="0" Opacity="0.55" />

    <SolidColorBrush x:Key="TextBrush" Color="#FFDCDDE3" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF8A8C96" />

    <SolidColorBrush x:Key="GlassBg" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="GlassBgStrong" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="GlassBgSoft" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="GlassBorder" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderStrong" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="DisplayBg" Color="#08FFFFFF" />

    <SolidColorBrush x:Key="OperatorTint" Color="#384668A8" />
    <SolidColorBrush x:Key="DangerTint" Color="#2EFF5B5B" />
    <SolidColorBrush x:Key="DangerText" Color="#FFF0A0A0" />

    <LinearGradientBrush x:Key="PanelSpecular" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0" />
        <GradientStop Color="#05FFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WindowBaseBg" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF06070B" Offset="0" />
        <GradientStop Color="#FF0B0D13" Offset="0.5" />
        <GradientStop Color="#FF05060A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowGlowVioletTL" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowPinkTR" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowCyanBR" Color="Transparent" />
    <SolidColorBrush x:Key="WindowGlowGreenBL" Color="Transparent" />

</ResourceDictionary>
