<Window x:Class="CalcPro.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CalcPro.Wpf.ViewModels"
        xmlns:converters="clr-namespace:CalcPro.Wpf.Converters"
        mc:Ignorable="d"
        Title="Calc Pro"
        Width="780" Height="720"
        MinWidth="320" MinHeight="500"
        SizeChanged="OnWindowSizeChanged"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFontFamily}"
        Foreground="{DynamicResource TextBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:BoolToVisConverter x:Key="BoolToVis" />
        <converters:InvBoolToVisConverter x:Key="InvBoolToVis" />
        <converters:InvBoolConverter x:Key="InvBool" />

        <!-- Строка системы счисления в «Программисте»: подпись слева, число справа;
             выбранная система подсвечена. Щелчок - вводить в этой системе. -->
        <Style x:Key="BaseRow" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,1" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassBgSoft}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GlassBgStrong}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <converters:PrettyExpressionConverter x:Key="PrettyExpression" />

        <!-- Кнопки окна в цвет темы, как в Calc Pro Glass: системная полоса заголовка со
             светлыми кнопками бросалась в глаза на тёмном стекле. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Background" Value="{DynamicResource GlassBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlassBgStrong}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#D9FF5050" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:CalcViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="D0" Command="{Binding PressDigitCommand}" CommandParameter="0" />
        <KeyBinding Key="D1" Command="{Binding PressDigitCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Command="{Binding PressDigitCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Command="{Binding PressDigitCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Command="{Binding PressDigitCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Command="{Binding PressDigitCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Command="{Binding PressDigitCommand}" CommandParameter="6" />
        <KeyBinding Key="D7" Command="{Binding PressDigitCommand}" CommandParameter="7" />
        <KeyBinding Key="D8" Command="{Binding PressDigitCommand}" CommandParameter="8" />
        <KeyBinding Key="D9" Command="{Binding PressDigitCommand}" CommandParameter="9" />
        <KeyBinding Key="NumPad0" Command="{Binding PressDigitCommand}" CommandParameter="0" />
        <KeyBinding Key="NumPad1" Command="{Binding PressDigitCommand}" CommandParameter="1" />
        <KeyBinding Key="NumPad2" Command="{Binding PressDigitCommand}" CommandParameter="2" />
        <KeyBinding Key="NumPad3" Command="{Binding PressDigitCommand}" CommandParameter="3" />
        <KeyBinding Key="NumPad4" Command="{Binding PressDigitCommand}" CommandParameter="4" />
        <KeyBinding Key="NumPad5" Command="{Binding PressDigitCommand}" CommandParameter="5" />
        <KeyBinding Key="NumPad6" Command="{Binding PressDigitCommand}" CommandParameter="6" />
        <KeyBinding Key="NumPad7" Command="{Binding PressDigitCommand}" CommandParameter="7" />
        <KeyBinding Key="NumPad8" Command="{Binding PressDigitCommand}" CommandParameter="8" />
        <KeyBinding Key="NumPad9" Command="{Binding PressDigitCommand}" CommandParameter="9" />
        <KeyBinding Key="OemPeriod" Command="{Binding PressDigitCommand}" CommandParameter="." />
        <KeyBinding Key="Decimal" Command="{Binding PressDigitCommand}" CommandParameter="." />
        <KeyBinding Key="OemComma" Command="{Binding PressDigitCommand}" CommandParameter="." />

        <KeyBinding Key="Add" Command="{Binding PressOperatorCommand}" CommandParameter="+" />
        <KeyBinding Key="OemPlus" Command="{Binding PressOperatorCommand}" CommandParameter="+" />
        <KeyBinding Key="OemPlus" Modifiers="Shift" Command="{Binding PressOperatorCommand}" CommandParameter="+" />
        <KeyBinding Key="Subtract" Command="{Binding PressOperatorCommand}" CommandParameter="-" />
        <KeyBinding Key="OemMinus" Command="{Binding PressOperatorCommand}" CommandParameter="-" />
        <KeyBinding Key="Multiply" Command="{Binding PressOperatorCommand}" CommandParameter="*" />
        <KeyBinding Key="Divide" Command="{Binding PressOperatorCommand}" CommandParameter="/" />

        <KeyBinding Key="A" Command="{Binding PressDigitCommand}" CommandParameter="A" />
        <KeyBinding Key="B" Command="{Binding PressDigitCommand}" CommandParameter="B" />
        <KeyBinding Key="C" Command="{Binding PressDigitCommand}" CommandParameter="C" />
        <KeyBinding Key="D" Command="{Binding PressDigitCommand}" CommandParameter="D" />
        <KeyBinding Key="E" Command="{Binding PressDigitCommand}" CommandParameter="E" />
        <KeyBinding Key="F" Command="{Binding PressDigitCommand}" CommandParameter="F" />

        <KeyBinding Key="Enter" Command="{Binding PressEqualsCommand}" />
        <KeyBinding Key="Return" Command="{Binding PressEqualsCommand}" />

        <KeyBinding Key="Back" Command="{Binding PressBackspaceCommand}" />
        <KeyBinding Key="Delete" Command="{Binding PressClearEntryCommand}" />
        <KeyBinding Key="Escape" Command="{Binding PressClearCommand}" />

        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyResultCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteResultCommand}" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="{Binding ToggleHistoryCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding PressMemoryCommand}" CommandParameter="MR" />
    </Window.InputBindings>

    <!-- Окно прозрачное, фон и скруглённые углы рисует этот Grid: у системного скругления
         Windows 11 радиус около 8 px, а нужен побольше. Углы срезает Clip из
         UpdateCornerClip (у развёрнутого окна - прямые). -->
    <Grid x:Name="WindowRoot" Background="{DynamicResource WindowBaseBg}">
        <!-- ==================== Layer 0: cosmic background gradients ==================== -->
        <Rectangle Fill="{DynamicResource WindowGlowVioletTL}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowGlowPinkTR}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowGlowCyanBR}" IsHitTestVisible="False" />
        <Rectangle Fill="{DynamicResource WindowGlowGreenBL}" IsHitTestVisible="False" />

        <!-- ==================== Свой заголовок окна ====================
             Системная полоса убрана (WindowChrome), рамка Windows осталась: прилипание к
             краям, изменение размера, тень и скругление Windows 11 работают как раньше.
             Тянуть окно можно за всю верхнюю полосу, двойной щелчок разворачивает. -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="18,14,0,0"
                    IsHitTestVisible="False">
            <Image Source="pack://application:,,,/CalcPro;component/Resources/app.png" Width="16" Height="16" Margin="0,0,8,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Calc Pro" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,12,0"
                    Panel.ZIndex="10">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" ToolTip="Свернуть" Click="OnMinimizeClick">
                <Path Data="M0,0 L10,0" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Width="10" Height="1.4" Stretch="Fill" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Tag="close" ToolTip="Закрыть" Click="OnCloseClick">
                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4" Width="9" Height="9" />
            </Button>
        </StackPanel>

        <!-- ==================== Layer 1: main content ==================== -->
        <Grid x:Name="ContentRoot" Margin="14,44,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ===================== Calculator main panel ===================== -->
            <!-- Поля, шрифт табло и видимость панелей меняет MainWindow.ApplyLayout
                 по правилу WindowLayout: минимум окна 320x500, как у калькулятора Windows. -->
            <ContentControl x:Name="CalcPanel"
                            Grid.Column="0"
                            Style="{StaticResource GlassPanel}"
                            Margin="0,0,7,0">
                <Grid x:Name="CalcInner" Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ============ Header: mode + angle + memory indicator ============ -->
                    <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                            <Border Background="{DynamicResource AccentGradient}"
                                    CornerRadius="8"
                                    Padding="8,3"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsMemoryActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="M" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>

                            <!-- Тема оформления: те же пять, что в Paint Pro. Меню собирает
                                 code-behind (OnThemeButtonClick): это чистое оформление. -->
                            <Button x:Name="ThemeButton"
                                    Style="{StaticResource PillButton}"
                                    Click="OnThemeButtonClick"
                                    ToolTip="Тема оформления"
                                    Width="44" Margin="0,0,4,0">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                      Data="M8,1.5 A6.5,6.5 0 1 0 8,14.5 C8.9,14.5 9.3,13.9 9.3,13.3 C9.3,12.5 8.6,12.3 8.6,11.5 C8.6,10.8 9.2,10.3 9.9,10.3 L11.5,10.3 A3.5,3.5 0 0 0 15,6.8 C15,3.9 11.9,1.5 8,1.5 Z M4.8,6.3 A0.9,0.9 0 1 0 4.8,8.1 A0.9,0.9 0 1 0 4.8,6.3 Z M7.3,3.5 A0.9,0.9 0 1 0 7.3,5.3 A0.9,0.9 0 1 0 7.3,3.5 Z M10.7,4.3 A0.9,0.9 0 1 0 10.7,6.1 A0.9,0.9 0 1 0 10.7,4.3 Z" />
                            </Button>

                            <Button x:Name="AngleButton"
                                    Style="{StaticResource PillButton}"
                                    Command="{Binding ToggleAngleModeCommand}"
                                    Visibility="{Binding IsProgrammer, Converter={StaticResource InvBoolToVis}}"
                                    Width="50" Margin="0,0,4,0">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="DEG" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDegrees}" Value="False">
                                                    <Setter Property="Text" Value="RAD" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>

                        <!-- Режим - меню из трёх пунктов: Standard, Scientific, Programmer (1.6.0).
                             Меню собирает code-behind (OnModeButtonClick), как у тем. -->
                        <Button x:Name="ModeButton"
                                Grid.Column="3"
                                Style="{StaticResource PillButton}"
                                Click="OnModeButtonClick"
                                ToolTip="Режим"
                                MinWidth="86">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ModeName}" />
                                <TextBlock Text=" ▾" Opacity="0.7" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ============ Display panel ============ -->
                    <ContentControl x:Name="DisplayPanel"
                                    Grid.Row="1"
                                    Style="{StaticResource GlassPanelSoft}"
                                    Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding Expression, Converter={StaticResource PrettyExpression}}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       MinHeight="20" />
                            <!-- Длинное число уменьшается, а не обрезается многоточием: в узком
                                 окне от 146623988754610578 оставалось «14662398875…». Высота
                                 постоянная (ApplyLayout), чтобы табло не прыгало. -->
                            <Viewbox x:Name="DisplayBox"
                                     Grid.Row="1"
                                     Height="62"
                                     StretchDirection="DownOnly"
                                     HorizontalAlignment="Right"
                                     Margin="0,6,0,0">
                                <TextBlock x:Name="DisplayText"
                                           Text="{Binding Display}"
                                           FontSize="46"
                                           FontWeight="Light"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextAlignment="Right">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="DisplayTranslate" Y="0" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Viewbox>
                        </Grid>
                    </ContentControl>

                    <!-- ============ Memory + history buttons row ============ -->
                    <!-- В «Программисте» ряда памяти нет: память у обычных чисел, а место нужно строкам
                         систем счисления. История открывается и там - Ctrl+H. -->
                    <UniformGrid x:Name="MemoryRow" Grid.Row="2" Rows="1" Columns="6" Margin="0,12,0,12"
                                 Visibility="{Binding IsProgrammer, Converter={StaticResource InvBoolToVis}}">
                        <Button Style="{StaticResource PillButton}"
                                Command="{Binding PressMemoryCommand}" CommandParameter="MC"
                                Content="MC" Margin="3,0" />
                        <Button Style="{StaticResource PillButton}"
                                Command="{Binding PressMemoryCommand}" CommandParameter="MR"
                                Content="MR" Margin="3,0" />
                        <Button Style="{StaticResource PillButton}"
                                Command="{Binding PressMemoryCommand}" CommandParameter="M+"
                                Content="M+" Margin="3,0" />
                        <Button Style="{StaticResource PillButton}"
                                Command="{Binding PressMemoryCommand}" CommandParameter="M-"
                                Content="M-" Margin="3,0" />
                        <Button Style="{StaticResource PillButton}"
                                Command="{Binding PressMemoryCommand}" CommandParameter="MS"
                                Content="MS" Margin="3,0" />
                        <!-- Значок вместо слова History: в узком окне шесть подписей не помещаются. -->
                        <Button x:Name="HistoryButton"
                                Style="{StaticResource PillButton}"
                                Command="{Binding ToggleHistoryCommand}"
                                ToolTip="History (Ctrl+H)" Margin="3,0">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                                  Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M8,4.2 L8,8 L10.6,9.6" />
                        </Button>
                    </UniformGrid>

                    <!-- ============ «Программист»: число во всех четырёх системах ============ -->
                    <StackPanel x:Name="BaseRows" Grid.Row="3" Margin="0,10,0,8"
                                Visibility="{Binding IsProgrammer, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource BaseRow}" IsChecked="{Binding BaseIsHex, Mode=OneWay}"
                                      Command="{Binding PressProgCommand}" CommandParameter="HEX">
                            <DockPanel>
                                <TextBlock Text="HEX" Width="38" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="16">
                                    <TextBlock Text="{Binding ProgHex}" FontSize="14" />
                                </Viewbox>
                            </DockPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource BaseRow}" IsChecked="{Binding BaseIsDec, Mode=OneWay}"
                                      Command="{Binding PressProgCommand}" CommandParameter="DEC">
                            <DockPanel>
                                <TextBlock Text="DEC" Width="38" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="16">
                                    <TextBlock Text="{Binding ProgDec}" FontSize="14" />
                                </Viewbox>
                            </DockPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource BaseRow}" IsChecked="{Binding BaseIsOct, Mode=OneWay}"
                                      Command="{Binding PressProgCommand}" CommandParameter="OCT">
                            <DockPanel>
                                <TextBlock Text="OCT" Width="38" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="16">
                                    <TextBlock Text="{Binding ProgOct}" FontSize="14" />
                                </Viewbox>
                            </DockPanel>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource BaseRow}" IsChecked="{Binding BaseIsBin, Mode=OneWay}"
                                      Command="{Binding PressProgCommand}" CommandParameter="BIN">
                            <DockPanel>
                                <TextBlock Text="BIN" Width="38" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="16">
                                    <TextBlock Text="{Binding ProgBin}" FontSize="14" />
                                </Viewbox>
                            </DockPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- ============ Button grid ============ -->
                    <Grid x:Name="KeysGrid" Grid.Row="4"
                          Visibility="{Binding IsProgrammer, Converter={StaticResource InvBoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SciColA" Width="0" />
                            <ColumnDefinition x:Name="SciColB" Width="0" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                                <Setter Property="Margin" Value="4" />
                                <!-- No fixed MinHeight: the seven star rows share whatever height
                                     the window has, so the bottom row is never clipped. -->
                                <Setter Property="MinHeight" Value="24" />
                            </Style>
                        </Grid.Resources>

                        <!-- ===== Scientific column A (hidden in Standard) ===== -->
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="sin" Content="sin" />
                        <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="cos" Content="cos" />
                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="tan" Content="tan" />
                        <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="asin" Content="asin" />
                        <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="acos" Content="acos" />
                        <Button Grid.Row="5" Grid.Column="0" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="atan" Content="atan" />
                        <Button Grid.Row="6" Grid.Column="0" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressConstantCommand}" CommandParameter="pi" Content="π" />

                        <!-- ===== Scientific column B ===== -->
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="log" Content="log" />
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="ln" Content="ln" />
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="exp" Content="exp" />
                        <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="sqrt" Content="√" />
                        <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressOperatorCommand}" CommandParameter="^" Content="x^y" />
                        <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="abs" Content="abs" />
                        <Button Grid.Row="6" Grid.Column="1" Style="{StaticResource FunctionButton}" Margin="4"
                                Command="{Binding PressConstantCommand}" CommandParameter="e" Content="e" />

                        <!-- ===== Standard 4-col layout (columns 2..5) ===== -->
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource DangerButton}"
                                Command="{Binding PressClearCommand}" Content="AC" />
                        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource DangerButton}"
                                Command="{Binding PressClearEntryCommand}" Content="C" />
                        <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource DangerButton}"
                                Command="{Binding PressBackspaceCommand}" Content="⌫" />
                        <Button Grid.Row="0" Grid.Column="5" Style="{StaticResource OperatorButton}"
                                Command="{Binding PressOperatorCommand}" CommandParameter="/" Content="÷" />

                        <Button Grid.Row="1" Grid.Column="2"
                                Command="{Binding PressFunctionCommand}" CommandParameter="sqr" Content="x²"
                                ToolTip="square the current number" />
                        <Button Grid.Row="1" Grid.Column="3"
                                Command="{Binding PressOperatorCommand}" CommandParameter="%" Content="%" />
                        <Button Grid.Row="1" Grid.Column="4"
                                Command="{Binding PressParenCommand}" CommandParameter="(" Content="(" />
                        <Button Grid.Row="1" Grid.Column="5" Style="{StaticResource OperatorButton}"
                                Command="{Binding PressOperatorCommand}" CommandParameter="*" Content="×" />

                        <Button Grid.Row="2" Grid.Column="2"
                                Command="{Binding PressDigitCommand}" CommandParameter="7" Content="7" />
                        <Button Grid.Row="2" Grid.Column="3"
                                Command="{Binding PressDigitCommand}" CommandParameter="8" Content="8" />
                        <Button Grid.Row="2" Grid.Column="4"
                                Command="{Binding PressDigitCommand}" CommandParameter="9" Content="9" />
                        <Button Grid.Row="2" Grid.Column="5" Style="{StaticResource OperatorButton}"
                                Command="{Binding PressOperatorCommand}" CommandParameter="-" Content="−" />

                        <Button Grid.Row="3" Grid.Column="2"
                                Command="{Binding PressDigitCommand}" CommandParameter="4" Content="4" />
                        <Button Grid.Row="3" Grid.Column="3"
                                Command="{Binding PressDigitCommand}" CommandParameter="5" Content="5" />
                        <Button Grid.Row="3" Grid.Column="4"
                                Command="{Binding PressDigitCommand}" CommandParameter="6" Content="6" />
                        <Button Grid.Row="3" Grid.Column="5" Style="{StaticResource OperatorButton}"
                                Command="{Binding PressOperatorCommand}" CommandParameter="+" Content="+" />

                        <Button Grid.Row="4" Grid.Column="2"
                                Command="{Binding PressDigitCommand}" CommandParameter="1" Content="1" />
                        <Button Grid.Row="4" Grid.Column="3"
                                Command="{Binding PressDigitCommand}" CommandParameter="2" Content="2" />
                        <Button Grid.Row="4" Grid.Column="4"
                                Command="{Binding PressDigitCommand}" CommandParameter="3" Content="3" />
                        <Button Grid.Row="4" Grid.Column="5" Grid.RowSpan="3" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PressEqualsCommand}" Content="=" />

                        <Button Grid.Row="5" Grid.Column="2"
                                Command="{Binding PressSignCommand}" Content="±" />
                        <Button Grid.Row="5" Grid.Column="3"
                                Command="{Binding PressDigitCommand}" CommandParameter="0" Content="0" />
                        <Button Grid.Row="5" Grid.Column="4"
                                Command="{Binding PressDigitCommand}" CommandParameter="." Content="." />

                        <Button Grid.Row="6" Grid.Column="2"
                                Command="{Binding PressParenCommand}" CommandParameter=")" Content=")" />
                        <Button Grid.Row="6" Grid.Column="3"
                                Command="{Binding PressOperatorCommand}" CommandParameter="^" Content="x^y" />
                        <Button Grid.Row="6" Grid.Column="4"
                                Command="{Binding PressFunctionCommand}" CommandParameter="sqrt" Content="√" />
                    </Grid>

                    <!-- ============ Клавиатура «Программиста» (1.6.0) ============
                         Цифр, которых в выбранной системе нет, нажать нельзя: A-F только в
                         HEX, 8 и 9 - от DEC, 2-7 - от OCT. -->
                    <Grid x:Name="ProgKeysGrid" Grid.Row="4"
                          Visibility="{Binding IsProgrammer, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                                <Setter Property="Margin" Value="4" />
                                <Setter Property="MinHeight" Value="24" />
                            </Style>
                        </Grid.Resources>
                        <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource FunctionButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="AND" Content="AND" />
                        <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource FunctionButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="OR" Content="OR" />
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FunctionButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="XOR" Content="XOR" />
                        <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource FunctionButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="NOT" Content="NOT" />
                        <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource FunctionButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="Mod" Content="Mod" />
                        <Button Grid.Row="1" Grid.Column="0" IsEnabled="{Binding BaseIsHex}"
                                Command="{Binding PressProgCommand}" CommandParameter="A" Content="A" />
                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource FunctionButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="&lt;&lt;" Content="&lt;&lt;" />
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FunctionButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="&gt;&gt;" Content="&gt;&gt;" />
                        <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource DangerButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="AC" Content="AC" />
                        <Button Grid.Row="1" Grid.Column="4" Style="{StaticResource DangerButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="⌫" Content="⌫" />
                        <Button Grid.Row="2" Grid.Column="0" IsEnabled="{Binding BaseIsHex}"
                                Command="{Binding PressProgCommand}" CommandParameter="B" Content="B" />
                        <Button Grid.Row="2" Grid.Column="1"
                                Command="{Binding PressProgCommand}" CommandParameter="(" Content="(" />
                        <Button Grid.Row="2" Grid.Column="2"
                                Command="{Binding PressProgCommand}" CommandParameter=")" Content=")" />
                        <Button Grid.Row="2" Grid.Column="3"
                                Command="{Binding PressProgCommand}" CommandParameter="±" Content="±" />
                        <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource OperatorButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="÷" Content="÷" />
                        <Button Grid.Row="3" Grid.Column="0" IsEnabled="{Binding BaseIsHex}"
                                Command="{Binding PressProgCommand}" CommandParameter="C" Content="C" />
                        <Button Grid.Row="3" Grid.Column="1" IsEnabled="{Binding AllowsOctDigits}"
                                Command="{Binding PressProgCommand}" CommandParameter="7" Content="7" />
                        <Button Grid.Row="3" Grid.Column="2" IsEnabled="{Binding AllowsDecDigits}"
                                Command="{Binding PressProgCommand}" CommandParameter="8" Content="8" />
                        <Button Grid.Row="3" Grid.Column="3" IsEnabled="{Binding AllowsDecDigits}"
                                Command="{Binding PressProgCommand}" CommandParameter="9" Content="9" />
                        <Button Grid.Row="3" Grid.Column="4" Style="{StaticResource OperatorButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="×" Content="×" />
                        <Button Grid.Row="4" Grid.Column="0" IsEnabled="{Binding BaseIsHex}"
                                Command="{Binding PressProgCommand}" CommandParameter="D" Content="D" />
                        <Button Grid.Row="4" Grid.Column="1" IsEnabled="{Binding AllowsOctDigits}"
                                Command="{Binding PressProgCommand}" CommandParameter="4" Content="4" />
                        <Button Grid.Row="4" Grid.Column="2" IsEnabled="{Binding AllowsOctDigits}"
                                Command="{Binding PressProgCommand}" CommandParameter="5" Content="5" />
                        <Button Grid.Row="4" Grid.Column="3" IsEnabled="{Binding AllowsOctDigits}"
                                Command="{Binding PressProgCommand}" CommandParameter="6" Content="6" />
                        <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource OperatorButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="−" Content="−" />
                        <Button Grid.Row="5" Grid.Column="0" IsEnabled="{Binding BaseIsHex}"
                                Command="{Binding PressProgCommand}" CommandParameter="E" Content="E" />
                        <Button Grid.Row="5" Grid.Column="1"
                                Command="{Binding PressProgCommand}" CommandParameter="1" Content="1" />
                        <Button Grid.Row="5" Grid.Column="2" IsEnabled="{Binding AllowsOctDigits}"
                                Command="{Binding PressProgCommand}" CommandParameter="2" Content="2" />
                        <Button Grid.Row="5" Grid.Column="3" IsEnabled="{Binding AllowsOctDigits}"
                                Command="{Binding PressProgCommand}" CommandParameter="3" Content="3" />
                        <Button Grid.Row="5" Grid.Column="4" Style="{StaticResource OperatorButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="+" Content="+" />
                        <Button Grid.Row="6" Grid.Column="0" IsEnabled="{Binding BaseIsHex}"
                                Command="{Binding PressProgCommand}" CommandParameter="F" Content="F" />
                        <Button Grid.Row="6" Grid.Column="1" Style="{StaticResource DangerButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="CE" Content="CE" />
                        <Button Grid.Row="6" Grid.Column="2"
                                Command="{Binding PressProgCommand}" CommandParameter="0" Content="0" />
                        <Button Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PressProgCommand}" CommandParameter="=" Content="=" />
                    </Grid>
                </Grid>
            </ContentControl>

            <!-- ===================== History panel ===================== -->
            <!-- Видимость, колонку и ширину ставит ApplyLayout: в узком окне история
                 открывается вместо клавиатуры, как в калькуляторе Windows. -->
            <ContentControl x:Name="HistoryPanel"
                            Grid.Column="1"
                            Style="{StaticResource GlassPanel}"
                            Width="270"
                            Margin="7,0,0,0"
                            Visibility="Collapsed">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Назад к клавиатуре: только в узком окне, где история на её месте. -->
                        <Button x:Name="HistoryBackButton"
                                Style="{StaticResource PillButton}"
                                Command="{Binding ToggleHistoryCommand}"
                                ToolTip="Back to the keypad"
                                Content="‹" FontSize="20" Width="40" Margin="0,0,8,0"
                                Visibility="Collapsed" />
                        <TextBlock Grid.Column="1"
                                   Text="History"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Style="{StaticResource PillButton}"
                                Command="{Binding ClearHistoryCommand}"
                                Content="Clear" Width="60" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <!-- Отступ справа: полоса прокрутки ложилась поверх правого края записей. -->
                        <ItemsControl ItemsSource="{Binding HistoryEntries}" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GlassButton}"
                                            Margin="0,4"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.UseHistoryEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <!-- Пример и результат по правой стенке, как в калькуляторе Windows:
                                             раньше пара стояла по центру кнопки, и результат прыгал
                                             вслед за длиной примера. Отступ здесь, а не Padding кнопки:
                                             шаблон GlassButton Padding не применяет. -->
                                        <StackPanel Margin="12,8">
                                            <TextBlock Text="{Binding Expression, Converter={StaticResource PrettyExpression}}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextDimBrush}"
                                                       TextAlignment="Right"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Result}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextAlignment="Right"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="Click an entry to reuse its result."
                               FontSize="11"
                               Foreground="{DynamicResource TextDimBrush}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </Grid>
            </ContentControl>
        </Grid>

        <!-- Тонкая светлая кромка по скруглённому краю, как у панелей стекла. -->
        <Border x:Name="WindowEdge" BorderBrush="{DynamicResource GlassBorder}" BorderThickness="1"
                CornerRadius="14" IsHitTestVisible="False" Panel.ZIndex="20" />
    </Grid>
</Window>
