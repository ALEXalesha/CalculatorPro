<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable, Segoe UI, -apple-system, SF Pro Display</FontFamily>

    <!-- ===== Base text style ===== -->
    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>

    <!-- Фон окна и все цвета живут в словарях тем: Resources/Themes/*.xaml. -->

</ResourceDictionary>
