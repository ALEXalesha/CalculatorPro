<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure calculator engine: tokenizer, Pratt parser, decimal evaluator and the
    undoable command set. No WPF dependency, so tests run fast on plain net8.0.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>CalcPro.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CalcPro.Tests" />
  </ItemGroup>

</Project>
